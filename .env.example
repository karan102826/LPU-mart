# ==============================================================================
# LPUmart — Production & Local Development Environment Variables (.env.example)
# ==============================================================================

# Gemini AI API Key for server-side proxy (Injected automatically in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase PostgreSQL & Authentication Configuration
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# AI Provider Abstraction (Default: gemini, extensible for openai/anthropic)
AI_PROVIDER="gemini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Upstash Redis (Distributed Sliding Window Rate Limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Security & CORS
JWT_SECRET="lpumart_governed_campus_jwt_secret"
ALLOWED_ORIGINS="http://localhost:3000"
